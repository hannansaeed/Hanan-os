rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for validation
    function isValidId(id) {
      return id is string && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidWhiteboard(data) {
      return data.keys().hasAll(['dataUrl', 'updatedAt']) 
        && data.keys().hasOnly(['dataUrl', 'updatedAt'])
        && data.dataUrl is string 
        && data.dataUrl.size() <= 1048000
        && data.updatedAt is string;
    }

    // Rules for whiteboards collection
    match /whiteboards/{boardId} {
      allow get, list: if isValidId(boardId);
      allow create, update: if isValidId(boardId) 
        && isValidWhiteboard(request.resource.data);
      allow delete: if isValidId(boardId);
    }
  }
}
